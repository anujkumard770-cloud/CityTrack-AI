# CityTrack AI Configuration
APP_NAME=CityTrack AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./citytrack.db

# Storage Directories
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MODELS_DIR=./models_weights

# AI Model Paths (YOLOv8 & Dedicated Plate Detector)
VEHICLE_MODEL_PATH=yolov8n.pt
PLATE_MODEL_PATH=./models_weights/license_plate_detector.pt

# ANPR / OCR Settings
OCR_ENGINE=easyocr
CONFIDENCE_THRESHOLD=0.35
PLATE_CONFIDENCE_THRESHOLD=0.30
TRACKER_TYPE=bytetrack.yaml

# Demo Mode & Privacy
ENABLE_DEMO_DATA=true
MASK_PLATES_ON_DISPLAY=false
DATA_RETENTION_DAYS=30
